# ==================== Session ====================
# Random long string used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-long-random-string

# ==================== Google Sheets ====================
# The ID of your Google Sheet (from its URL):
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=

# Display-only, shown in the admin Settings tab.
GOOGLE_SHEET_NAME=Attendance System

# Provide EITHER GOOGLE_CREDENTIALS_JSON (the full contents of your service
# account's JSON key file, on one line) OR the two variables below.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences literal (don't replace with real newlines) —
# the app converts them automatically.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# ==================== Misc ====================
TIMEZONE=Asia/Karachi

# ==================== Analytics (optional) ====================
# Used by the /admin/analytics punctuality chart to decide what counts as
# "on time". Both have sensible defaults if you leave them unset.
EXPECTED_START_TIME=09:00:00
EXPECTED_GRACE_MINUTES=15
